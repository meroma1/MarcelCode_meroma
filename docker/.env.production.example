# Variables d'environnement pour la production
# Copier ce fichier vers .env et remplir avec vos valeurs

# Anthropic API Key (obligatoire)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# OpenAI API Key (optionnel, nécessaire pour la transcription vocale)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Azure AD Configuration (obligatoire en production)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_AUDIENCE=api://marcelia

# Sécurité
REQUIRE_AUTH=true
CORS_ORIGIN=https://votre-domaine.com,https://*.votre-domaine.com

# Base de données (changez le mot de passe en production !)
POSTGRES_PASSWORD=changez-ce-mot-de-passe-en-production

# Ports (optionnel, valeurs par défaut)
POSTGRES_PORT=5432
REDIS_PORT=6379
